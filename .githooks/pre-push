#!/usr/bin/env bash
# Block a push if anything in the files or in any commit looks private.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Never push a failing or half-committed tree.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: commit or stash your changes first" >&2
  exit 1
fi
if [ -d .venv/bin ]; then PATH="$PWD/.venv/bin:$PATH"; fi
ruff check .
ruff format --check .
mypy
pytest -q --cov

python3 scripts/check_leaks.py tree
python3 scripts/check_leaks.py history
gitleaks git --no-banner --redact --log-opts="--all" .
